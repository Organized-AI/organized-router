{
  "name": "organized-router",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Self-hosted LLM gateway with provider cache affinity, opt-in exact response caching, and cache usage receipts.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --config wrangler.toml --dry-run --outdir dist",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:runtime": "node scripts/runtime-test.mjs",
    "codex:local": "node scripts/codex-local.mjs",
    "router:status": "node scripts/local-status.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.133.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
